<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 备份规则
    本项目所有数据都存放在 Room 沙箱数据库中，备份语义交给系统默认即可
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
