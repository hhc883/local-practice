<?xml version="1.0" encoding="utf-8"?>
<!--
    本地题库刷题 APP
    全部功能离线运行，无需运行时权限：
      - 文件读取使用 SAF（Storage Access Framework），由系统授权给单个 Uri
      - 不访问外部存储根目录
    AI 功能（可选）：需要联网调用硅基流动 API，由用户主动配置 API Key 后才启用
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        AI 助手功能所需的网络权限：未配置 API Key 时 App 仍完全离线运行
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".QuestionBankApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuestionBank"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuestionBank">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SAF 接收 .json 文件时可声明：仅 app 内打开，不暴露深链；
            项目暂不提供 <intent-filter>，避免被其它 app 唤起。
        -->
    </application>
</manifest>
