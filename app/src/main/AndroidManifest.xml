<?xml version="1.0" encoding="utf-8"?>
<!--
    本地题库刷题 APP
    全部功能离线运行，不申请任何运行时权限：
      - 文件读取使用 SAF（Storage Access Framework），由系统授权给单个 Uri
      - 不访问外部存储根目录
      - 不进行网络通信
    故 manifest 中只声明 Application 与主 Activity。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        显式禁用硬件加速/调试以外的网络特性以体现离线策略
        （保留 INTERNET 注释作为反例，禁止取消注释）
    -->
    <!-- <uses-permission android:name="android.permission.INTERNET"/> -->

    <application
        android:name=".QuestionBankApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuestionBank"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuestionBank">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SAF 接收 .json 文件时可声明：仅 app 内打开，不暴露深链；
            项目暂不提供 <intent-filter>，避免被其它 app 唤起。
        -->
    </application>
</manifest>
